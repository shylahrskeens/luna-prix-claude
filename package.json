{
  "name": "luna-prix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Luna Prix - an Axie kart racer for the Ronin Vibeathon",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "server": "npm run build:server && node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "build:server": "esbuild server/sim-entry.ts --bundle --platform=node --format=esm --outfile=server/sim.mjs --log-level=error",
    "check:geometry": "esbuild tools/validate.ts --bundle --platform=node --format=esm --outfile=.tmp/validate.mjs --log-level=error && node .tmp/validate.mjs",
    "check:races": "esbuild tools/headless.ts --bundle --platform=node --format=esm --outfile=.tmp/headless.mjs --log-level=error && node .tmp/headless.mjs \"\" 3,7,11,19,23,31,37",
    "check": "npm run typecheck && npm run check:geometry && npm run check:races"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "ws": "^8.18.0"
  }
}
